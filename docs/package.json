{
  "name": "dumpsock-docs",
  "version": "0.1.0",
  "description": "DumpSock docs — external (public) and internal (Tailnet-only).",
  "private": true,
  "type": "module",
  "scripts": {
    "external:dev":   "vitepress dev external",
    "external:build": "vitepress build external",
    "external:preview": "vitepress preview external",
    "internal:dev":   "vitepress dev internal --port 5175",
    "internal:build": "vitepress build internal",
    "internal:preview": "vitepress preview internal --port 5175",
    "dev": "echo 'Use external:dev or internal:dev' && exit 1"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
