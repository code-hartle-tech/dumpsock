# Build outputs
/dist/
/bin/
*.exe
*.app/
*.dmg
*.msi
*.AppImage

# Go
*.test
*.out
/coverage/
/vendor/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Per-project Claude state (matches neartrace-android-mvp convention)
.claude/

# Secrets — should never appear; gitignore as belt-and-suspenders
.env
.env.*
*.key
*.pem
*.p12
*.provisionprofile

# Icon build intermediates
/assets/icon/build/
/assets/icon/*.icns
/assets/icon/*.ico
/assets/icon/*.png
!/assets/icon/preview.png

# VitePress build artifacts + npm
/docs/node_modules/
/docs/external/.vitepress/dist/
/docs/external/.vitepress/cache/
/docs/internal/.vitepress/dist/
/docs/internal/.vitepress/cache/
# NOTE: /docs/package-lock.json is intentionally NOT ignored — committing
# it gives CI (npm ci) reproducible installs and is the standard practice
# for Pages-deployed sites. Add it back to the gitignore only if you
# really know why.
